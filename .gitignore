server/.env
!*.env.example
!server/.env.example

# ---------- 日志 ----------
*.log
server/backend.*.log
web/dev.*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 / 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ---------- 本地计划 / 缓存 ----------
.claude/
.cache/
*.local
